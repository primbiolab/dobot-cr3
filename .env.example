# Copy to .env.local for development. The app must build and boot with all of
# these unset: demo mode (mock telemetry, placeholder video, no auth gate).

# Central Supabase project — the platform's, never a lab-owned one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Which remote_labs row this deployment is. Registered in the platform
# catalogue already; do not change it without a platform admin.
NEXT_PUBLIC_LAB_SLUG=dobot-cr3

# Backend origin: the Cloudflare Tunnel to the lab computer
# (https://dobot-cr3-control.primbiolab.org). Empty = demo mode, no hardware.
NEXT_PUBLIC_CONTROL_URL=

# Production only: ".primbiolab.org" shares the session with the hub and all
# labs. Leave unset in development.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# The platform hub. Where signing out lands, and where "volver al panel" goes.
# Defaults to https://primbiolab.org; point it at a local hub (e.g.
# http://localhost:3001) when running both apps on one machine.
NEXT_PUBLIC_HUB_URL=

# Defense-in-depth mirror of public.allowed_email_domains (comma-separated).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=unal.edu.co

# Control lease + Pub/Sub fan-out, for a deployment that is not on Workers.
# On Cloudflare the lease lives in the CONTROL_LEASE Durable Object instead and
# this stays unset. Unset and not on Workers = in-memory store, which is
# correct for a single process (next dev, the lease test) and only that: the
# app will not mint a lease token from a per-instance store on a multi-instance
# runtime, so a deployment with neither configured stays view-only.
REDIS_URL=

# Shared secret between this app and the edge gatekeeper on the lab computer.
# The app signs a short-lived lease token with it; the gatekeeper verifies that
# token before letting a command through to ROS 2. Must be identical on both
# sides (>= 32 chars). Unset here = the app cannot mint lease tokens, so the
# gatekeeper rejects every actuation: the UI stays view-only. Never
# NEXT_PUBLIC_ — this must not reach a browser bundle.
LAB_CONTROL_SIGNING_SECRET=

# Set only on the lab computer, which is the only place the heartbeat may run:
# beating from the UI worker would report the lab online whenever Cloudflare is
# up, whatever the robot is doing. See scripts/heartbeat.mjs and the systemd
# unit in edge/systemd/.
LAB_HEARTBEAT_SECRET=
